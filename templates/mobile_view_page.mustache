{{!
    @template mod_wordcloud/mobile_view_page
    This template renders the wordcloud activity page in the Moodle App.

    Classes required for JS:
    * None

    Data attibutes required for JS:
    * All data attributes are required

    Context variables required for this template:
    * cmid
    * wordcloud
    * writeaccess
    * showgroups
    * groups

    Example context (json):
    {
        "cmid": "25",
        "wordcloud": {
            "id": "1",
            "course": "2",
            "name": "wordcloud",
            "intro": "wordcloud"
        },
        "writeaccess": true,
        "showgroups": false
    }
}}
{{=<% %>=}}
<core-course-module-description description="<% wordcloud.intro %>" component="mod_wordcloud" componentId="<% cmid %>">
</core-course-module-description>
<%# showgroups %>
<ion-item>
    <ion-select name="group" [(ngModel)]="CONTENT_OTHERDATA.group"
        label="{{ 'plugin.mod_wordcloud.selectagroup' | translate }}"
        (ionChange)="updateContent({cmid: <% cmid %>, courseid: <% wordcloud.course %>, group: CONTENT_OTHERDATA.group})"
        interface="popover">
        <%# groups %>
            <ion-select-option [value]="<% id %>"><% name %></ion-select-option>
        <%/ groups %>
    </ion-select>
</ion-item>
<%/ showgroups %>
<ion-card>
    <%# writeaccess %>
    <ion-item>
        <ion-input id="mod-wordcloud-new-word" [label]="'plugin.mod_wordcloud.textbox' | translate"
            labelPlacement="stacked" maxlength="40" [(ngModel)]="CONTENT_OTHERDATA.word"></ion-input>
        <ion-button slot="end" core-site-plugins-call-ws
                    name="mod_wordcloud_add_word" [params]="{aid: <% wordcloud.id %>, word: CONTENT_OTHERDATA.word, groupid: CONTENT_OTHERDATA.group}"
                    [preSets]="{getFromCache: 0, saveToCache: 0}" confirmMessage
                    (onSuccess)="addWordCallDone($event)">
            {{ 'plugin.mod_wordcloud.submitbtn' | translate }}
        </ion-button>
    </ion-item>
    <%/ writeaccess %>
    <ion-card-content>
        <div id="mod-wordcloud-words-box" style="overflow:auto;"></div>
    </ion-card-content>
</ion-card>
<div class="center">
    {{ 'plugin.mod_wordcloud.refreshtext' | translate }}
</div>
